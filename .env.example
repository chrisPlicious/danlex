# Supabase (Vercel Marketplace integration fills these in; for local dev copy from `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only for `npm run db:apply` (Dashboard → Connect → Session pooler). Remove after setup if you like.
SUPABASE_DB_URL=

# Organiser login, used only by `npm run admin:create`
ADMIN_EMAIL=
ADMIN_PASSWORD=
