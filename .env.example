# Supabase (Vercel Marketplace integration fills these in; for local dev copy from `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only for `npm run db:apply` (Dashboard → Connect → Session pooler). Remove after setup if you like.
SUPABASE_DB_URL=

# The one admin account. The login page only asks for the password, so the server needs ADMIN_EMAIL at runtime
# (set it on your host too). ADMIN_PASSWORD is only read by `npm run admin:create` and can stay local.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Confirmation emails go out through this Gmail account. Needs 2-Step Verification and an App Password
# (myaccount.google.com/apppasswords), not the normal account password. Set these on your host too.
GMAIL_USER=
GMAIL_APP_PASSWORD=
